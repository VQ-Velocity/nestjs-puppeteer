{
  "name": "nestjs-puppeteer",
  "description": "Puppeteer module for Velocity NestJS",
  "version": "0.3.0",
  "license": "UNLICENSED",
  "author": "Vision Quest Virtual LLC",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "watch": "rm -rf dist && tsc -w -p tsconfig.json",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint 'lib/**/*.ts' --fix",
    "prepare": "npm run build",
    "semantic-release": "semantic-release",
    "reinstall": "rm -rf node_modules && npm cache clean --force && npm install && npm outdated",
    "reinstall:full": "rm -rf node_modules && rm -rf package-lock.json && npm cache clean --force && npm install && npm outdated"
  },
  "engines": {
    "node": "24.14.x",
    "npm": ">=11.9.0 <11.13.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/testing": "^11.1.13",
    "@types/node": "^22.15.15",
    "puppeteer": "^23.11.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "typescript": "5.5.4"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "puppeteer": "^23",
    "puppeteer-extra": "^3",
    "reflect-metadata": "*",
    "rxjs": "*"
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VQ-Velocity/nestjs-puppeteer.git"
  }
}
